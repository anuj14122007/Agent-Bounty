# AgentBounty Application Configuration
# Copy this file to .env for local development

# Environment: development, test, production
APP_ENV=development

# Demo Mode: When true, operates fully offline with simulated providers
DEMO_MODE=true

# Payment Provider: mock, paypal (DEMO_MODE requires mock)
PAYMENT_PROVIDER=mock

# PayPal Integration (Sandbox only; live mode is strictly prohibited)
PAYPAL_PAYOUTS_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SENDER_COUNTRY=US
PAYPAL_TIMEOUT_SECONDS=10.0

# Financial Safety Limits (USD Decimal, max per-task bounty)
MAX_BOUNTY_USD=5.00

# Persistence
DATABASE_URL=sqlite:///./data/agentbounty.db
